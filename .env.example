# Скопируй этот файл в .env и подставь свои ключи.
# Ноутбук читает их через os.environ.get(...).

# Alchemy / Infura HTTPS endpoint, например:
# https://eth-mainnet.g.alchemy.com/v2/<KEY>
ETH_HTTP_NODE=

# Etherscan API key (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=

# The Graph decentralized gateway API key (https://thegraph.com/studio/apikeys/)
THEGRAPH_API_KEY=

# Dune Analytics API key (https://dune.com/settings/api)
DUNE_API_KEY=
